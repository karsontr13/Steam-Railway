<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>SteamRailway</AssemblyName>
    <RootNamespace>SteamRailway</RootNamespace>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS0618;MSB3277</NoWarn>
    <TLD Condition="'$(TLD)' == ''">D:\SteamLibrary\steamapps\common\TheLongDark</TLD>
    <!-- Set to false to build without copying into the game's Mods folder. -->
    <CopyToMods Condition="'$(CopyToMods)' == ''">true</CopyToMods>
  </PropertyGroup>

  <ItemGroup>
    <!-- Helper projects (Tools\NoDLCTest) and the Unity editor script (Unity\Editor) are built elsewhere. -->
    <Compile Remove="Tools\**;Unity\**;Blender\**;Assets\**" />
    <None Remove="Tools\**;Unity\**;Blender\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(TLD)\MelonLoader\net6\MelonLoader.dll" Private="false" />
    <Reference Include="$(TLD)\MelonLoader\net6\0Harmony.dll" Private="false" />
    <Reference Include="$(TLD)\MelonLoader\net6\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(TLD)\MelonLoader\net6\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(TLD)\MelonLoader\Il2CppAssemblies\*.dll" Private="false" />
    <Reference Include="$(TLD)\Mods\ModData.dll" Private="false" />
    <!-- Optional at run time (MelonOptionalDependencies): the in-game settings page. -->
    <Reference Include="$(TLD)\Mods\ModSettings.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\steamrailway.bundle" LogicalName="steamrailway.bundle" />
    <EmbeddedResource Include="Assets\SOUND_CREDITS.txt" LogicalName="SOUND_CREDITS.txt" />
    <EmbeddedResource Include="Assets\Dynamite\SteamRailwayDynamite.modcomponent" LogicalName="Dynamite/SteamRailwayDynamite.modcomponent" Condition="Exists('Assets\Dynamite\SteamRailwayDynamite.modcomponent')" />
    <EmbeddedResource Include="Assets\Data\**\*" LogicalName="Data/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="CopyToGameMods" AfterTargets="Build" Condition="'$(CopyToMods)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(TLD)\Mods" />
  </Target>
</Project>
